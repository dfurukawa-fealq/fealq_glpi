# ===== CONTAINER =====
CONTAINER_NAME=glpi-app

# ===== NETWORK =====
DOCKER_NETWORK_NAME=network-name

# ===== DATABASE - External MySQL =====
GLPI_DB_HOST=kawa_mysql
GLPI_DB_PORT=3306
GLPI_DB_NAME=kawa_glpi
GLPI_DB_USER=root
GLPI_DB_PASSWORD=change-me-to-a-secure-password

# ===== PORTS =====
GLPI_PORT=8081
GLPI_CONTAINER_PORT=80

# ===== TIMEZONE =====
TIMEZONE=America/Sao_Paulo

# ===== DASHGLPI WEB PUSH =====
# Gere um par VAPID estável e mantenha a chave privada somente no ambiente.
DASHGLPI_PUSH_ENABLED=true
DASHGLPI_PUSH_VAPID_SUBJECT=mailto:admin@example.com
DASHGLPI_PUSH_VAPID_PUBLIC_KEY=
DASHGLPI_PUSH_VAPID_PRIVATE_KEY=

# ===== GLPI =====
GLPI_VERSION=10.0.18
GLPI_SKIP_AUTOINSTALL=false
